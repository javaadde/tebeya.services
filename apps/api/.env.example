PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/tebeya_services
JWT_SECRET=supersecret_jwt_key_change_in_production
JWT_REFRESH_SECRET=supersecret_refresh_key_change_in_production
CORS_ORIGIN=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authorized Admin Web Control Emails (comma-separated)
admin_web_controll_emails=admin@tebeya.services,owner@tebeya.services

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=Tebeya Services <noreply@tebeya.services>
